# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL 16 (docker-compose service name `postgres`)
POSTGRES_DB=pawprint
POSTGRES_USER=pawprint
POSTGRES_PASSWORD=pawprint
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis 7
REDIS_URL=redis://redis:6379/0

# S3-compatible storage (MinIO local)
AWS_STORAGE_BUCKET_NAME=pawprint-private
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=0

# Frontend
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — Google/Gmail OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Payments (TEST MODE)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMONGO_SECRET_KEY=sk_test_...
PAYMONGO_WEBHOOK_SECRET=whsec_...
PAYMONGO_BASE_URL=https://api.paymongo.com

# AI vision gatekeeper
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45

# Email (mailpit in dev)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
